# Copy this file to .env and replace every placeholder before deployment.
NODE_ENV=production
PORT=3000
PUBLIC_SITE_URL=https://www.your-domain.example
# Use a strong unique password of at least 16 characters.
ADMIN_PASSWORD=replace-with-a-long-unique-password
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-at-least-32-random-characters
# Persistent writable folder on your hosting provider. Keep it mounted across deploys.
DATA_DIR=./data

# Verified Jimnaya business contact details (international format recommended).
BUSINESS_PHONE=
BUSINESS_EMAIL=
WHATSAPP_NUMBER=
BUSINESS_ADDRESS=
BUSINESS_HOURS=

# Email notifications via Resend (https://resend.com). Verify your sending domain first.
RESEND_API_KEY=
NOTIFICATION_EMAIL=
FROM_EMAIL=Jimnaya Website <enquiries@your-verified-domain.example>
